create table pierre.imoveis (
  id smallint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  imv_codigo text not null,
  titulo text null,
  fonte_url text null,
  atualizado_em timestamp with time zone null default (now() AT TIME ZONE 'America/Sao_Paulo'::text),
  tipo text not null,
  finalidade public.finalidade_enum not null,
  uf text not null,
  cidade text not null,
  regiao_cidade text null,
  bairro text null,
  endereco text null,
  preco integer not null,
  preco_mensal boolean not null,
  condominio_preco real null,
  iptu_preco real null,
  area_util_m2 real null,
  area_total_m2 real null,
  quartos smallint null,
  suites smallint null,
  banheiros smallint null,
  vagas_carro smallint null,
  andar smallint null,
  ano smallint null,
  mobiliado text null,
  aceita_pet boolean null default true,
  imagem_principal text null,
  destaques text null,
  comodidades text null,
  proximidades text null,
  condicoes text null,
  restricoes text null,
  constraint imoveis_pkey primary key (id),
  constraint imoveis_imv_codigo_key unique (imv_codigo)
) TABLESPACE pg_default;
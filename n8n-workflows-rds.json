      {
        "parameters": {
          "jsCode": "const message = JSON.parse($input.first().json.messages)\n\nconst preferencias = message.preferencias;\n\nconst finalidade = preferencias.finalidade;\nconst precoMin = preferencias.faixa_preco - preferencias.faixa_preco * 0.2;\nconst precoMax = preferencias.faixa_preco + preferencias.faixa_preco * 0.2;\nconst cidade = preferencias.cidade;\nconst quartos = preferencias.quartos;\nconst suites = preferencias.suites;\nconst banheiros = preferencias.banheiros;\nconst tipo = preferencias.tipo;\nconst bairro = preferencias.bairro;\nconst regiao = preferencias.regiao_cidade;\nconst vagas = preferencias.vagas_carro;\nconst aceita_pet = preferencias.aceita_pet;\nconst mobiliado = preferencias.mobiliado;\n\nlet query = \"SELECT titulo, finalidade, preco, condominio_preco, cidade, quartos, suites, banheiros, tipo, bairro, vagas_carro, aceita_pet, mobiliado, imagem_principal FROM imoveis WHERE 1=1\";\n// WHERE 1=1 porque precisa existir antes do AND\n\nif (finalidade) query += ` AND finalidade ILIKE '${finalidade}'`;\nif (precoMin) query += ` AND preco >= ${precoMin}`;\nif (precoMax) query += ` AND preco <= ${precoMax}`;\nif (cidade) query += ` AND unaccent(cidade) ILIKE unaccent('${cidade}')`;\nif (quartos) query += ` AND quartos >= ${quartos} - 2`;\nif (quartos) query += ` AND quartos <= ${quartos} + 2`;\nif (banheiros) query += ` AND banheiros >= ${banheiros} - 2`;\nif (banheiros) query += ` AND banheiros <= ${banheiros} + 2`;\nif (suites) query += ` AND suites >= ${suites} - 2`;\nif (suites) query += ` AND suites <= ${suites} + 2`;\nif (tipo) query += ` AND tipo = '${tipo}'`;\nif (bairro) query += ` AND unaccent(bairro) ILIKE unaccent('${bairro}')`;\nif (vagas) query += ` AND vagas_carro = '${vagas}'`;\nif (regiao) query += ` AND regiao_cidade ILIKE '${regiao}'`;\nif (aceita_pet) query += ` AND aceita_pet = '${aceita_pet}'`;\nif (mobiliado) query += ` AND mobiliado = '${mobiliado}'`;\n\nreturn [{ query }];\n"
        },
